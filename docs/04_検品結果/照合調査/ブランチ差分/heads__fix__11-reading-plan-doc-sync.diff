+```
+$ curl -s -w "\nHTTP %{http_code}\n" -X POST http://localhost:8022/api/v1/books \
+  -H "Accept: application/json" -H "Content-Type: application/json" \
+  -H "Authorization: Bearer $TOKEN" \
+  -d '{"user_id":2,"title":"検品テスト本","author":"検品著者","isbn":"9990000000001","published_date":"2020-01-01","genres":[5,2]}'
